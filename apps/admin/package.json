{
  "name": "shirtat-admin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && npm run check:design && npm run check:skills && npm run check:registry && npm run check:llms",
    "check:fix": "biome check --write",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/server/seo/checks.test.ts",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/database.ts seed",
    "auth:test": "node --experimental-strip-types scripts/auth-test.ts",
    "data:parity": "node --env-file-if-exists=.env --experimental-strip-types scripts/data-parity.ts",
    "assistant:test": "node --experimental-strip-types scripts/assistant-check.ts",
    "assistant:ui": "node --experimental-strip-types scripts/assistant-ui-check.ts",
    "assistant:browser": "node --experimental-strip-types scripts/assistant-browser-check.ts",
    "assistant:server": "node --experimental-strip-types scripts/assistant-server-check.ts",
    "assistant:worker": "node --experimental-strip-types scripts/assistant-worker-check.ts",
    "assistant:conversation": "node --experimental-strip-types scripts/assistant-conversation-check.ts",
    "assistant:lifecycle": "node --experimental-strip-types scripts/assistant-lifecycle-browser-check.ts",
    "assistant:context": "node --experimental-strip-types scripts/assistant-context-browser-check.ts",
    "assistant:modes": "node --experimental-strip-types scripts/assistant-modes-check.ts",
    "new:dashboard": "node --experimental-strip-types scripts/new-page.ts dashboard",
    "new:page": "node --experimental-strip-types scripts/new-page.ts page",
    "generators:test": "node --env-file-if-exists=.env --experimental-strip-types scripts/generators-test.ts",
    "check:skills:test": "node --experimental-strip-types scripts/check-skills-test.ts",
    "check:skills": "node --experimental-strip-types scripts/check-skills.ts",
    "check:design": "node --experimental-strip-types scripts/check-design.ts",
    "check:design:test": "node --experimental-strip-types scripts/design-check-test.ts",
    "verify:page": "node --experimental-strip-types scripts/verify-page.ts",
    "verify:page:test": "node --experimental-strip-types scripts/verify-page-test.ts",
    "registry:build": "node --experimental-strip-types scripts/registry-build.ts",
    "llms:build": "node --experimental-strip-types scripts/llms.ts",
    "check:registry": "node --experimental-strip-types scripts/registry-build.ts --check",
    "check:llms": "node --experimental-strip-types scripts/llms.ts --check",
    "assistant:canvas": "node --experimental-strip-types scripts/assistant-canvas-check.ts",
    "assistant:canvas-browser": "node --experimental-strip-types scripts/assistant-canvas-browser-check.ts",
    "auth:ensure-owner": "node --env-file-if-exists=.env --experimental-strip-types scripts/ensure-owner.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/openai-compatible": "3.0.77",
    "@ai-sdk/xai": "5.0.29",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fullcalendar/react": "^7.1.3",
    "@hookform/resolvers": "^5.9.2",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.132.0",
    "ai": "7.0.152",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "nitro": "^3.0.260903-beta",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.1.18",
    "temporal-polyfill": "^1.0.6",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.45",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "version": "0.10.1",
  "engines": {
    "node": ">=22"
  },
  "description": "Shirtat admin. Built from the MIT tenboards template."
}

# Leave DATABASE_URL unset for the zero-config demo. Production uses a Neon pooled URL.
# DATABASE_URL=postgresql://tenboards:tenboards_local@127.0.0.1:54329/tenboards
# Migrations use the direct (non-pooler) Neon URL: npm run db:migrate -- --allow-remote
# DATA_SOURCE=demo forces demo even when DATABASE_URL is configured; unset the auth secret too.

# Authentication requires a migrated database. Generate a private secret: openssl rand -base64 32
# Production (VERCEL_ENV=production) fails closed when BETTER_AUTH_SECRET is missing.
# BETTER_AUTH_SECRET=your-better-auth-secret-here
# BETTER_AUTH_URL=http://localhost:3000
# OWNER_EMAIL=moe@10claws.com
# OWNER_PASSWORD=your-owner-password-here

# Catalog and sitemap counts. Same names as the storefront. Unset shows Not connected.
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=shirtatco.myshopify.com
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Search Console. Unset shows Not connected on the SEO plan.
# GSC_CLIENT_ID=your-gsc-client-id-here
# GSC_CLIENT_SECRET=your-gsc-client-secret-here
# GSC_REFRESH_TOKEN=your-gsc-refresh-token-here

# Production provisioning is in docs/deploy.md.
# Never put production secrets in this example.

# Optional adopter-owned Assistant providers; keep all unset for recorded replies.
# Keys are server-only. Never prefix them with VITE_. Never use real keys in previews/tests.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# META_API_KEY=
# META_MODEL=muse-spark-1.3
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.8-flash
# Hosted live auth-off requires an explicit HTTPS origin; auth-on must agree with BETTER_AUTH_URL.
# ASSISTANT_ORIGIN=https://your-own-dashboard.example

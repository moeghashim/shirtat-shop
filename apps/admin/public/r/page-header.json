  "css": {
    "@import \"@fontsource-variable/geist\"": {},
    "@import \"@fontsource-variable/geist-mono\"": {},
    "@custom-variant dark (&:is(.dark *))": {},
    "@layer base": {
      "*": { "@apply border-border outline-ring/50": {} },
      "body": {
        "@apply bg-background text-foreground text-sm": {},
        "font-variation-settings": "var(--app-font-variation-settings)",
        "font-variant-numeric": "tabular-nums"
      },
      "html": { "@apply font-sans": {} },
      ":is(button, [data-slot=\"button\"], [data-slot=\"select-trigger\"], [data-slot=\"input\"])": {
        "min-height": "1.5rem",
        "min-width": "1.5rem"
      }
    },
    "@media (min-width: 48rem)": {
      ":root": {
        "--spacing": "0.21875rem",
        "--space-1": "0.21875rem",
        "--space-2": "0.4375rem",
        "--space-3": "0.75rem",
        "--space-4": "0.875rem",
        "--space-6": "1.3125rem",
        "--space-8": "1.75rem",
        "--shell-header-height": "3rem"
      }
    },
    "[data-slot=\"card\"][data-size=\"sm\"]": { "--card-spacing": "0.75rem" },
    ":is([data-slot=\"chart\"], .fc, [data-slot=\"calendar\"])": { "--spacing": "0.25rem" },
    "[data-slot=\"select-trigger\"]:not(.w-full),\n[data-slot=\"tabs-trigger\"]": { "min-width": "max-content" },
    "[data-slot=\"avatar-fallback\"]": { "font-size": "max(0.75rem, 1em)" },
    "@media (max-width: 47.999rem)": {
      ":is([data-slot=\"input\"], [data-slot=\"textarea\"], select)": { "font-size": "1rem" }
    },
    ".disable-transitions *": { "transition": "none !important" },
    ":where(a, button, input, textarea, select, [tabindex]):focus-visible": {
      "outline": "2px solid var(--ring)",
      "outline-offset": "2px"
    },
    ":where(h1, h2, h3, [data-slot=\"card-title\"])": { "letter-spacing": "-0.025em", "text-wrap": "balance" },
    "::selection": { "color": "var(--primary-foreground)", "background": "var(--primary)" },
    ":where(input, textarea)": { "caret-color": "var(--primary)" },
    "@media (prefers-reduced-motion: reduce)": {
      "*, *::before, *::after": {
        "animation-duration": "0.01ms !important",
        "animation-iteration-count": "1 !important",
        "transition-duration": "0.01ms !important",
        "scroll-behavior": "auto !important"
      }
    }
  },
  "meta": { "themeSource": "src/styles/styles.css", "kitSection": "page-header" },
  "docs": "Requires React 19 and an initialized Tailwind v4 + shadcn project. Installs the tenboards default theme globally (light/dark, typography, density, focus and motion); review CSS changes. Components and exact UI dependencies live under components/tenboards, helpers under lib/tenboards. No server/data/auth dependencies.",
  "type": "registry:style"

{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "scripts/assistant-renderer-probe.tsx",
    "scripts/communication-state-probe.tsx",
    "scripts/operational-state-probe.tsx",
    "scripts/worker-dev.ts",
    "scripts/worker-runtime-check.ts",
    "scripts/worker-auth-test.ts",
    "scripts/worker-rate-limit-check.ts",
    "scripts/worker-parity-harness.ts",
    "scripts/deploy-check.ts",
    "scripts/deploy-prepare.ts",
    "scripts/preview-deploy.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@shop/*": ["../../lib/*"],
      "zod/v4": ["./node_modules/zod/v4/index.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}

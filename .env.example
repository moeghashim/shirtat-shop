# Required
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="shirtatco.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token-here"
NEXT_PUBLIC_SHOPIFY_SHOP_ID="123456789"

# Optional
# OPENAI_API_KEY="your-openai-api-key-here" # Server-only key for the shopping assistant. Eve calls OpenAI directly as gpt-6-luna with medium reasoning. Voice mode mints Realtime ephemeral tokens with the same key. Never use a NEXT_PUBLIC_ name.
# VOICE_MODE_ENABLED="1" # Set to 1 to turn voice on. Leave unset, or set 0, and voice stays off.
# VOICE_SESSION_MAX_SECONDS="300" # Per-session cap for a voice conversation. Defaults to 300 (5 minutes).
# VOICE_DAILY_SESSION_CAP="40" # Server cap on voice sessions per UTC day.
# VOICE_DAILY_MINUTE_CAP="200" # Server cap on reserved voice minutes per UTC day.
# VOICE_MINT_LIMIT="8" # How many ephemeral tokens one caller can mint per window.
# VOICE_MINT_WINDOW_SECONDS="600" # Window for VOICE_MINT_LIMIT.
# CHAT_REVIEW_CAPTURE="1" # Opt in after review. Eve then stores redacted shopper turns in the private Blob store for chat review on admin.shirtat.co/dashboard/chats. Leave unset so production does not copy every chat.
# AGENTMAIL_API_KEY="your-agentmail-api-key-here" # Sends custom-order emails from shirtat@agentmail.to; falls back to the ops mailer when unset.
# CUSTOM_ORDER_TOKEN="your-custom-order-token-here-at-least-24-chars" # Bearer token for POST /api/custom/upload, used by scripts/custom-order.mjs.
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here"
# DEBUG_SHOPIFY="1" # Log structured Shopify API operation timings.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="123456789"
# REVALIDATE_SECRET="your-revalidate-secret-here" # Set to refresh content Shopify sends no webhook for, such as pages, policies, and menus; send it as a Bearer token to POST /api/revalidate.
# SHOPIFY_API_VERSION="2026-10" # Override the Storefront API version, which defaults to the version Hydrogen targets.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET="your-customer-account-client-secret-here" # Required when auth.isEnabled is true.
# SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret-here"
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/agent/ucp-profile.json" # Optional override for the public Eve agent profile.

# SHIRTAT_ADMIN_URL="https://admin.shirtat.co" # Owner admin origin. /admin/* and /ar/admin/* redirect there; defaults to https://admin.shirtat.co.
# SHIRTAT_ADMIN_API_SECRET="random-48+-char-secret" # Shared with the shirtat-admin project. Signs owner requests to /api/internal/admin/*; unset rejects them all.
# GSC_CLIENT_ID="your-gsc-client-id-here" # OAuth client for read-only Search Console in the SEO plan. Leave unset to show Not connected.
# GSC_CLIENT_SECRET="your-gsc-client-secret-here" # Paired with GSC_CLIENT_ID. Server-only.
# GSC_REFRESH_TOKEN="your-gsc-refresh-token-here" # webmasters.readonly refresh token for sc-domain:shirtat.co.

# EVE_DEV="1" # Set by eve dev; selects Shopify's public example profile when local URLs are unreachable.
# VERCEL_ENV is provided by Vercel; previews use Shopify's public example agent profile.
